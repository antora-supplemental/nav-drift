{
  "name": "@antora-supplemental/nav-drift",
  "version": "0.1.0",
  "description": "CLI: compare nav.adoc / site-nav against published pages; report orphans and missing-from-nav",
  "license": "MIT",
  "author": "Ryan Johnson (https://github.com/AMDphreak)",
  "keywords": [
    "antora",
    "nav",
    "drift",
    "navigation"
  ],
  "homepage": "https://github.com/antora-supplemental/nav-drift",
  "bugs": {
    "url": "https://github.com/antora-supplemental/nav-drift/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antora-supplemental/nav-drift.git"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "packageManager": "pnpm@10.33.0",
  "bin": {
    "nav-drift": "bin/nav-drift.js"
  },
  "files": [
    "bin/**/*",
    "lib/**/*",
    "README.adoc",
    "CHANGELOG.adoc",
    "LICENSE"
  ],
  "dependencies": {
    "@antora-supplemental/triage-ux-kit": "github:antora-supplemental/triage-ux-kit#v0.1.0"
  }
}
